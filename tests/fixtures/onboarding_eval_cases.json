{
  "version": "2026-06-27.v1",
  "purpose": "LearnBuddy 对话入口的多轮语义接地验收集。重点验证通用路由，而不是某个名词的硬编码理解。",
  "method_sources": [
    {
      "title": "LangSmith Evaluation concepts",
      "url": "https://docs.langchain.com/langsmith/evaluation-concepts",
      "why": "区分 offline dataset、online threads、code/LLM/human evaluators。"
    },
    {
      "title": "Ragas Testset Generation",
      "url": "https://docs.ragas.io/en/stable/concepts/test_data_generation/",
      "why": "参考从资料构造评测样本的思路。"
    },
    {
      "title": "OpenAI Evals",
      "url": "https://github.com/openai/evals",
      "why": "参考用数据集衡量模型行为回归。"
    }
  ],
  "cases": [
    {
      "id": "tech_mcp_first_turn",
      "category": "known_or_groundable_tech_concept",
      "turn_count": 0,
      "history": [],
      "message": "我想学mcp方面的系统知识",
      "expect": {
        "clarify": false,
        "source_query_contains": ["mcp"],
        "anchor_contains": [],
        "forbid_question_contains": ["它属于哪个领域", "我需要先理解你说的 mcp"]
      }
    },
    {
      "id": "tech_rag_goal",
      "category": "known_or_groundable_tech_concept",
      "turn_count": 0,
      "history": [],
      "message": "我想学习 RAG 系统从 0 到上线的能力",
      "expect": {
        "clarify": false,
        "source_query_contains": ["rag"],
        "forbid_question_contains": ["它属于哪个领域"]
      }
    },
    {
      "id": "ambiguous_harness_first_turn",
      "category": "ambiguous_term",
      "turn_count": 0,
      "history": [],
      "message": "我想学会harness产品全套技术能力",
      "expect": {
        "clarify": true,
        "choices": false,
        "question_contains": ["不同语境", "最终想交付什么"],
        "source_query_contains": ["AI evaluation harness LLM"]
      }
    },
    {
      "id": "ambiguous_cursor_first_turn",
      "category": "ambiguous_term",
