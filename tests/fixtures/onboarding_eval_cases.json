        "clarify": false
      }
    }
  ],
  "acceptance_suites": [
    {
      "id": "onboarding_semantic_grounding",
      "owner": "core/intent.py + server.py",
      "gate": "所有 cases 必须通过；禁止出现已知技术词被当未知词反问。"
    },
    {
      "id": "source_grounding",
      "owner": "core/source_search.py",
      "gate": "技术词目标必须产生搜索 query；有内置权威来源时优先使用官方/开源来源，失败可降级但不能伪造。"
    },
    {
      "id": "conversation_memory",
      "owner": "ConversationEngine + build_anchor_context",
      "gate": "用户纠偏后，同一会话不能回到旧含义或重复同一澄清。"
    },
    {
      "id": "baseline_assessment",
      "owner": "core/prompts/system.md",
      "gate": "摸底题必须区分独立底座、AI 协作、验收纠错和迁移落地，不能只出可搜索定义题。"
    },
    {
      "id": "content_quality",
      "owner": "core/content.py + core/content_quality.py",
      "gate": "lesson 必须有来源、课设、互动链、练习和可观察产出；浅层讲义不通过质量门。"
    }
  ]
}
