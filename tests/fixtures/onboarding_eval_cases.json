    {
      "id": "correction_ai_harness_keeps_anchor",
      "category": "correction_memory",
      "turn_count": 2,
      "history": [
        {"role": "user", "content": "我想学习harness整体系统的落地"},
        {"role": "assistant", "content": "harness 在不同技术语境里含义不一样。"},
        {"role": "user", "content": "AI 领域的harness工程"},
        {"role": "assistant", "content": "明白，先按 AI 应用的运行与落地支撑层来理解。"}
      ],
      "message": "全流程落地，我想构建一套harness开发系统",
      "expect": {
        "clarify": false,
        "anchor_contains": ["AI harness 工程", "不要按 Harness.io"],
        "source_query_contains": ["AI application harness"]
      }
    },
    {
      "id": "unknown_new_term_uses_grounding_not_fixed_options",
      "category": "unknown_or_emerging_term",
      "turn_count": 0,
