# LearnBuddy 学习伙伴 · 环境变量模板
# 个人版推荐直接运行 bash scripts/setup_personal.sh；它会复制本文件并生成本地 secret。
# 严禁把 .env 提交到 git（已在 .gitignore 中排除）

# === 产品版本 ===
# 代码默认 cloud；个人自托管必须显式改为 personal。
LEARNBUDDY_EDITION=cloud

# 公有云页可展示的开源与部署入口；个人部署可留空。
LEARNBUDDY_GITHUB_URL=https://github.com/wanghui2323/learnbuddy
LEARNBUDDY_DEPLOY_URL=https://github.com/wanghui2323/learnbuddy/blob/main/docs/PERSONAL_DEPLOYMENT.md

# === LLM Provider（OpenAI-compatible BYOK）===
# 例：DeepSeek 用 https://api.deepseek.com + deepseek-chat。
LEARNBUDDY_LLM_API_KEY=
LEARNBUDDY_LLM_BASE_URL=https://api.deepseek.com
LEARNBUDDY_LLM_MODEL=deepseek-chat

# 旧版变量仍兼容；新部署优先填上面的 LEARNBUDDY_LLM_*。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# === 服务端口 ===
PORT=8000
HOST=127.0.0.1
LEARNBUDDY_PORT=8000
LEARNBUDDY_BIND_ADDRESS=127.0.0.1

# === 运行环境 ===
ENV=dev
ITUTOR_ENV=development
LOG_LEVEL=info

# === Cloud 管理员 ===
# 公开注册/登录不会按邮箱自动授予管理员，也不要再配置 ITUTOR_ADMIN_EMAILS。
# 先注册普通账号，再在部署机本地运行：
# python scripts/init_cloud_admin.py owner@example.com

# === Web Push（轨道 A · 移动端推送；未配则优雅降级，不报错）===
# 用 python scripts/gen_vapid.py 生成密钥对后填入
ITUTOR_VAPID_PRIVATE_KEY=        # DER base64 单行
ITUTOR_VAPID_PUBLIC_KEY=         # Base64URL，给前端 applicationServerKey
ITUTOR_VAPID_SUBJECT=mailto:you@example.com
ITUTOR_BASE_URL=                 # 推送 deep link 的 origin（如 https://itutor.example.com）；dev 留空走相对路径
ITUTOR_PUSH_HOUR=8               # 每天推送小时（本地时区）
ITUTOR_PUSH_ENABLED=1            # 0=关后台调度
ITUTOR_SCHEDULER_RUN=1           # 0=本进程不跑调度（多 worker 部署：web 进程设 0，独立进程跑）

# === 飞书 + OpenClaw 学习助手 ===
# 下列 secret 由 setup_personal.sh 独立生成，不要在聊天或仓库里传递真实值。
ITUTOR_AGENT_TOKEN_SECRET=
ITUTOR_OPENCLAW_BRIDGE_TOKEN=
ITUTOR_FEISHU_ACCOUNT_ID=default
ITUTOR_AGENT_REMINDERS_ENABLED=1

# 使用你自己创建并发布的飞书应用机器人。不需要把凭据交给 LearnBuddy 运营方。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 宿主机默认只能从 127.0.0.1 打开 Gateway Control UI。
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.8.2
OPENCLAW_FEISHU_PLUGIN_VERSION=2026.8.2
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_PORT=18789
